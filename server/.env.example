# 이 파일을 .env 로 복사해서 사용하세요. (.env는 git에 올리지 마세요)

# ---------- LLM ----------
# anthropic (Claude API, 유료) 또는 ollama (무료, 내 컴퓨터에서 실행)
LLM_BACKEND=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# 생각 깊이: low / medium / high / xhigh / max (짧은 추천 위주라 low면 충분)
ANTHROPIC_EFFORT=low

OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434

# ---------- 데이트 플래너: 실제 장소 정보 ----------
# kakao / google / none (비우면 키가 있는 쪽을 씀)
PLACES_PROVIDER=
# 카카오 디벨로퍼스 → 내 애플리케이션 → REST API 키 (국내 장소 정확, 영업시간은 장소 링크에서 확인)
KAKAO_REST_API_KEY=
# Google Cloud → Places API (New) 키 (영업시간까지 받아옴, 결제 계정 필요)
GOOGLE_PLACES_API_KEY=

# ---------- 배포판(Firebase)에서 쓸 때 ----------
# Firebase 프로젝트 ID를 넣으면 로그인한 회원의 요청만 받아요. 비우면 확인 없이 받음 (내 컴퓨터 시연용)
FIREBASE_PROJECT_ID=
# 앱 주소 (쉼표로 여러 개). 예: https://dul-app.web.app,https://dul-app.firebaseapp.com
ALLOWED_ORIGINS=
# 한 사람이 10분 동안 쓸 수 있는 AI 요청 수
AI_RATE_LIMIT=40
